# Local hackathon setup. Copy to `.env`; defaults below work with Docker Compose.
# These credentials are for local development only; do not use them in production.
FRONTEND_PORT=5173
BACKEND_PORT=8000
POSTGRES_PORT=5432
POSTGRES_DB=stikerai
POSTGRES_USER=stikerai
POSTGRES_PASSWORD=stikerai

# For a backend started directly on your machine (not inside Compose).
# Compose connects to `db` internally and builds its connection from the
# POSTGRES_* values above.
DATABASE_URL=postgresql+psycopg://stikerai:stikerai@localhost:5432/stikerai

# Optional AI explanation; choose a model supporting Responses structured outputs.
OPENAI_API_KEY=
OPENAI_MODEL=
# true only when serving the app over HTTPS
COOKIE_SECURE=false

# The integrations below are not wired into the app yet. Leave blank for the
# out-of-box demo; add credentials only when the corresponding adapter is built
# and the provider's access and usage terms have been reviewed.
# MIROFISH_BASE_URL=
# X_BEARER_TOKEN=
# YOUTUBE_API_KEY=
# TELEGRAM_BOT_TOKEN=

# Local hackathon setup. Copy to `.env`; defaults below work with Docker Compose.
# These credentials are for local development only; do not use them in production.
FRONTEND_PORT=5173
BACKEND_PORT=8000
POSTGRES_PORT=5432
POSTGRES_DB=stikerai
POSTGRES_USER=stikerai
POSTGRES_PASSWORD=stikerai

# For a backend started directly on your machine (not inside Compose).
# Compose connects to `db` internally and builds its connection from the
# POSTGRES_* values above.
DATABASE_URL=postgresql+psycopg://stikerai:stikerai@localhost:5432/stikerai

# Optional integrations are disabled by default. The MiroFish adapter submits
# only proposal text + a privacy-reviewed aggregate evidence brief to an
# authenticated, project-controlled gateway. Do not expose an upstream
# unauthenticated MiroFish instance directly to the network.
# OpenAI evaluation explanations are server-side only. Blank key disables the
# service; never put this key in frontend variables or source control.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=45
MIROFISH_ENABLED=false
MIROFISH_BASE_URL=
MIROFISH_API_TOKEN=
MIROFISH_TIMEOUT_SECONDS=45
# X_BEARER_TOKEN=
# YOUTUBE_API_KEY=
# TELEGRAM_BOT_TOKEN=

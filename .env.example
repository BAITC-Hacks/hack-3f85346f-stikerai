# Local hackathon setup. Copy to `.env`; defaults below work with Docker Compose.
# These credentials are for local development only; do not use them in production.
FRONTEND_PORT=5173
BACKEND_PORT=8000
# Optional OSM-compatible raster tile URL template. The browser can see this
# value; do not put private secrets in it. Public OSM tiles are best-effort.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
POSTGRES_PORT=5432
POSTGRES_DB=stikerai
POSTGRES_USER=stikerai
POSTGRES_PASSWORD=stikerai

# For a backend started directly on your machine (not inside Compose).
# Compose connects to `db` internally and builds its connection from the
# POSTGRES_* values above.
DATABASE_URL=postgresql+psycopg://stikerai:stikerai@localhost:5432/stikerai

# Optional AI explanation; both key and model must be configured.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=20
# Set true when serving the application over HTTPS.
COOKIE_SECURE=false
# Optional authenticated project-controlled MiroFish gateway.
MIROFISH_ENABLED=false
MIROFISH_BASE_URL=
MIROFISH_API_TOKEN=
MIROFISH_TIMEOUT_SECONDS=45

# Public map style; fetched by the browser only when the street layer is enabled.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
